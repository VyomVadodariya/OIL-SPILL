# ========================================
# SIH26143 — Environment Configuration
# ========================================
# Copy this file to .env and fill in actual values.
# DO NOT commit the .env file to version control.

# ---- Project ----
PROJECT_NAME=sih26143-oil-spill
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Satellite Data (Copernicus Data Space) ----
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# Or token-based:
# COPERNICUS_ACCESS_TOKEN=

# ---- AIS Provider ----
# AISStream (https://aisstream.io)
AISSTREAM_API_KEY=

# Global Fishing Watch (https://globalfishingwatch.org/our-apis/)
GFW_API_KEY=

# ---- Environmental / Ocean Data ----
# INCOIS (https://incois.gov.in)
INCOIS_API_KEY=

# HYCOM (https://www.hycom.org)
# Usually public, no key required

# ERA5 / CDS API (https://cds.climate.copernicus.eu)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# ---- Database (optional) ----
# MONGODB_URI=mongodb://localhost:27017/sih26143

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
